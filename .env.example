# /ask answer generation: "anthropic" (cloud, needs API key) or "ollama" (local)
LLM_PROVIDER=anthropic

# Claude API key, only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Local model settings, only used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Optional: Groq free tier (https://console.groq.com, no credit card).
# When set, collections in CLOUD_COLLECTIONS are answered by the fast cloud
# model; everything else stays on the local provider. Leave empty for 100%
# local operation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CLOUD_COLLECTIONS=wikivoyage

# Path to the folder containing your markdown notes
VAULT_PATH=D:\path\to\your\notes

# local = embedded Qdrant on disk (default), server = connect to QDRANT_URL
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
